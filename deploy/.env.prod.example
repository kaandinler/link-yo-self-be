# LinkYoSelf uretim ayarlari.
#
# Sunucuda deponun KOKUNE `.env` olarak kopyalayin (deploy/ altina degil):
#
#   cp deploy/.env.prod.example .env && chmod 600 .env
#
# compose bu dosyayi hem degisken yerlestirmede (${DOMAIN} ...) hem de
# konteynerlerin ortaminda kullaniyor. ENVIRONMENT, ALLOWED_HOSTS,
# ALLOWED_ORIGINS, FRONTEND_URL, MEDIA_URL, TRUSTED_PROXY_COUNT,
# FORWARDED_ALLOW_IPS ve WEB_CONCURRENCY BURAYA YAZILMIYOR:
# deploy/docker-compose.prod.yml onlari DOMAIN'den turetiyor.

# --- Zorunlu --------------------------------------------------------------
# Eksik olan varsa `docker compose up` hicbir konteyner baslatmadan duruyor.

# Alan adi, sema ve www olmadan. Site https://DOMAIN, API https://api.DOMAIN.
DOMAIN=

# Let's Encrypt'in sertifika uyarilarini gonderecegi adres.
ACME_EMAIL=

# JWT imzalama anahtari. Uretmek icin:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Veritabani parolasi. DIKKAT: Postgres bunu yalnizca birim ILK
# olusturuldugunda uyguluyor; sonradan degistirmek icin SQL ile
# (ALTER USER) de degistirilmeli.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- E-posta ----------------------------------------------------------------
# SMTP_HOST bossa e-posta GONDERILMEZ, icerik log'a yazilir: kayit
# dogrulama ve sifre sifirlama kullaniciya ulasmaz. Uretimde doldurun.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@alan-adiniz
# SMTP_USE_TLS=true

# --- Duman testi ------------------------------------------------------------
# Her yayindan sonra deploy/smoke.sh bu profili hem API'den hem sitenin
# kendisinden okuyup web'in API'ye ulastigini dogruluyor. En az bir
# gorunur linki olan gercek bir kullanici adi (ornegin kendi hesabiniz).
# Bos birakilirsa o kontrol atlanir.
# SMOKE_USERNAME=

# --- Istege bagli ---------------------------------------------------------
# NEXT_PUBLIC_IS_SIGN_UP_ENABLED=true
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# CLICK_DEDUP_SECONDS=30
#
# Avatarlari S3 uyumlu bir kovaya (Cloudflare R2 vb.) tasimak icin
# ana .env.example'daki "Avatar deposu" bolumune bakin; o durumda
# NEXT_PUBLIC_MEDIA_URL da verilmeli ve web yeniden derlenmeli.
