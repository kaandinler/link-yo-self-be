# PostgreSQL baglanti adresi (async driver ile)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/linkyoself

# JWT imzalama anahtari - production'da mutlaka degistirin
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# development | production
ENVIRONMENT=development

# production'da ZORUNLU (JSON liste formatinda). Bos birakilirsa
# uygulama ayaga kalkmiyor -- bilincli: eskiden bos liste sessizce
# "her origin / her Host kabul" anlamina geliyordu.
#
# Gelistirmede ALLOWED_ORIGINS bos birakilabilir; o zaman yalnizca
# FRONTEND_URL kabul edilir. Hicbir ortamda "*" kullanilmiyor.
# ALLOWED_HOSTS=["api.linkyoself.com"]
# ALLOWED_ORIGINS=["https://linkyoself.com"]

# Sifre sifirlama baglantisinin isaret ettigi frontend adresi
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# E-posta (SMTP). SMTP_HOST bos birakilirsa e-posta gonderilmez, icerik
# log'a yazilir - gelistirme icin yeterli, production'da doldurun.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@linkyoself.com
# SMTP_USE_TLS=true

# --- Hiz siniri ---------------------------------------------------------
#
# Onumuzde kac GUVENILIR ters vekil var? Uygulama bir ters vekilin
# (nginx, Cloudflare, yuk dengeleyici) arkasindaysa BU DEGER
# AYARLANMALI -- yoksa butun istekler vekilin tek adresinden geliyor
# gorunur ve tum kullanicilar ayni sayaci paylasir.
#
# 0 (varsayilan): X-Forwarded-For hic okunmuyor. Vekil arkasinda
# DEGILKEN dogrusu bu: basligi istemci uydurabilir ve ona koru korune
# guvenen bir sinirlayici tamamen atlatilir.
# TRUSTED_PROXY_COUNT=1

# Sayaclarin deposu. Bos birakilirsa surec ici bellek: sinirlar SUREC
# BASINA, yani uygulama N isciyle (ya da N sunucuda) kosarsa gercek
# sinir ~N katina cikar (olculdu: 1/2/4 isci -> 10/20/31-33, kural 10).
# Birden fazla isci ya da sunucu varsa VERILMELI. Uygulama ayaga
# kalkarken hangi deponun kullanildigini log'a yazar; WEB_CONCURRENCY>1
# ve Redis yoksa WARNING, Redis'e ulasilamiyorsa ERROR.
# REDIS_URL=redis://localhost:6379/0

# Yuk testinde kapatilmasi gerekebilir. Varsayilan acik; kapaliyken
# uygulama ayaga kalkarken WARNING yazar.
# RATE_LIMIT_ENABLED=true

# Ayni ziyaretcinin ayni linke tiklamasi kac saniye icinde TEK
# sayilsin? 0 = tekillestirme kapali.
#
# Anahtar IP oldugu icin uzun pencere, ayni adresin arkasindaki FARKLI
# kisileri (okul, ofis, mobil operatorun CGNAT'i) tek kisi sayardi.
# Gerekcenin tamami settings.py'de.
# CLICK_DEDUP_SECONDS=30
